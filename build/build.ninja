## This file contains all the build statements describing the
# compilation DAG.

# =============================================================================
# Write statements declared in CMakeLists.txt:
# 
# Which is the root file.
# =============================================================================

# =============================================================================
# Project: Matrix Math
# Configurations: Debug
# =============================================================================

#############################################
# Minimal version of Ninja required by this file

ninja_required_version = 1.5


#############################################
# Set configuration variable for custom commands.

CONFIGURATION = Debug
# =============================================================================
# Include auxiliary files.


#############################################
# Include rules file.

include CMakeFiles/rules.ninja

# =============================================================================

#############################################
# Logical path to working directory; prefix for absolute paths.

cmake_ninja_workdir = /Users/anna/Documents/github/matrix-math/build/
# =============================================================================
# Object build statements for STATIC_LIBRARY target matrix_lib


#############################################
# Order-only phony target for matrix_lib

build cmake_object_order_depends_target_matrix_lib: phony || CMakeFiles/matrix_lib.dir

build CMakeFiles/matrix_lib.dir/src/Matrix.cpp.o: CXX_COMPILER__matrix_lib_Debug /Users/anna/Documents/github/matrix-math/src/Matrix.cpp || cmake_object_order_depends_target_matrix_lib
  DEP_FILE = CMakeFiles/matrix_lib.dir/src/Matrix.cpp.o.d
  FLAGS = -g -isysroot /Library/Developer/CommandLineTools/SDKs/MacOSX26.1.sdk -mmacosx-version-min=15.7 -Wall -Wextra -std=gnu++17
  INCLUDES = -I/Users/anna/Documents/github/matrix-math/include
  OBJECT_DIR = CMakeFiles/matrix_lib.dir
  OBJECT_FILE_DIR = CMakeFiles/matrix_lib.dir/src
  TARGET_COMPILE_PDB = CMakeFiles/matrix_lib.dir/matrix_lib.pdb
  TARGET_PDB = libmatrix_lib.pdb


# =============================================================================
# Link build statements for STATIC_LIBRARY target matrix_lib


#############################################
# Link the static library libmatrix_lib.a

build libmatrix_lib.a: CXX_STATIC_LIBRARY_LINKER__matrix_lib_Debug CMakeFiles/matrix_lib.dir/src/Matrix.cpp.o
  ARCH_FLAGS = -isysroot /Library/Developer/CommandLineTools/SDKs/MacOSX26.1.sdk -mmacosx-version-min=15.7
  LANGUAGE_COMPILE_FLAGS = -g
  OBJECT_DIR = CMakeFiles/matrix_lib.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = CMakeFiles/matrix_lib.dir/matrix_lib.pdb
  TARGET_FILE = libmatrix_lib.a
  TARGET_PDB = libmatrix_lib.pdb

# =============================================================================
# Object build statements for EXECUTABLE target demo


#############################################
# Order-only phony target for demo

build cmake_object_order_depends_target_demo: phony || cmake_object_order_depends_target_matrix_lib

build CMakeFiles/demo.dir/main.cpp.o: CXX_COMPILER__demo_Debug /Users/anna/Documents/github/matrix-math/main.cpp || cmake_object_order_depends_target_demo
  DEP_FILE = CMakeFiles/demo.dir/main.cpp.o.d
  FLAGS = -g -isysroot /Library/Developer/CommandLineTools/SDKs/MacOSX26.1.sdk -mmacosx-version-min=15.7 -std=gnu++17
  INCLUDES = -I/Users/anna/Documents/github/matrix-math/include
  OBJECT_DIR = CMakeFiles/demo.dir
  OBJECT_FILE_DIR = CMakeFiles/demo.dir
  TARGET_COMPILE_PDB = CMakeFiles/demo.dir/
  TARGET_PDB = bin/demo.pdb


# =============================================================================
# Link build statements for EXECUTABLE target demo


#############################################
# Link the executable bin/demo

build bin/demo: CXX_EXECUTABLE_LINKER__demo_Debug CMakeFiles/demo.dir/main.cpp.o | libmatrix_lib.a || libmatrix_lib.a
  FLAGS = -g -isysroot /Library/Developer/CommandLineTools/SDKs/MacOSX26.1.sdk -mmacosx-version-min=15.7
  LINK_LIBRARIES = libmatrix_lib.a
  OBJECT_DIR = CMakeFiles/demo.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = CMakeFiles/demo.dir/
  TARGET_FILE = bin/demo
  TARGET_PDB = bin/demo.pdb


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /Users/anna/Documents/github/matrix-math/build && /usr/local/Cellar/cmake/3.24.2/bin/ccmake -S/Users/anna/Documents/github/matrix-math -B/Users/anna/Documents/github/matrix-math/build
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /Users/anna/Documents/github/matrix-math/build && /usr/local/Cellar/cmake/3.24.2/bin/cmake --regenerate-during-build -S/Users/anna/Documents/github/matrix-math -B/Users/anna/Documents/github/matrix-math/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

# =============================================================================
# Target aliases.

build demo: phony bin/demo

build matrix_lib: phony libmatrix_lib.a

# =============================================================================
# Folder targets.

# =============================================================================

#############################################
# Folder: /Users/anna/Documents/github/matrix-math/build

build all: phony libmatrix_lib.a bin/demo

